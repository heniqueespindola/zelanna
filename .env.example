# Cliente — visíveis na app (prefixo EXPO_PUBLIC_)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Client ID do cliente OAuth "Web application" na Google Cloud Console — usado por
# GoogleSignin.configure({ webClientId }) para obter o serverAuthCode. Não é secreto,
# mas o client_secret desse mesmo cliente NUNCA deve levar o prefixo EXPO_PUBLIC_ (ver abaixo).
EXPO_PUBLIC_GMAIL_WEB_CLIENT_ID=
# Client ID do cliente OAuth "iOS" na Google Cloud Console (Bundle ID com.mocruz.zelanna) —
# usado por GoogleSignin.configure({ iosClientId }). Sem client_secret (tipo "iOS" não tem).
EXPO_PUBLIC_GMAIL_IOS_CLIENT_ID=

# Servidor — NUNCA no cliente. Configurar como Secrets nas Edge Functions do Supabase
# (`supabase secrets set NOME=valor`), nunca aqui com o prefixo EXPO_PUBLIC_.
# VISION_LLM_API_KEY=
# STRIPE_SECRET_KEY=
# REVENUECAT_IOS_KEY=
# REVENUECAT_ANDROID_KEY=
# GMAIL_CLIENT_ID=          (mesmo valor de EXPO_PUBLIC_GMAIL_WEB_CLIENT_ID)
# GMAIL_CLIENT_SECRET=      (client_secret do cliente OAuth "Web application" — NUNCA no cliente)
